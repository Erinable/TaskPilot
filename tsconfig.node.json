{
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "uno.config.ts",
    "eslint.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "evals/**/*"
  ]
}
