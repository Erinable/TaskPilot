{
  "name": "taskpilot",
  "version": "0.1.0",
  "description": "A desktop workspace for human developers executing AI-authored coding work packages.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "prestart": "bash scripts/check_electron.sh",
    "start": "electron-vite preview",
    "predev": "bash scripts/check_electron.sh",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --mac",
    "typecheck": "vue-tsc --build --noEmit && vue-tsc -p tsconfig.test.json --noEmit",
    "pretest": "bash tests/scripts/coding_wrapper.test.sh",
    "test": "vitest run",
    "test:bootstrap": "bash tests/scripts/coding_wrapper.test.sh",
    "eval:product-lead": "node evals/product-lead/run.ts",
    "analyze:cycles": "knip --include cycles,unresolved",
    "analyze:unused": "knip --include files,dependencies,unlisted,exports,types",
    "analyze:duplicates": "jscpd src --config .jscpd.json",
    "analyze:complexity": "node scripts/analyze_complexity.ts",
    "check:complexity": "node scripts/analyze_complexity.ts --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:qa": "node evals/qa/run.ts",
    "eval:architect": "node evals/architect/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "electron": "40.10.6",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "element-plus": "2.14.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "jscpd": "5.4.2",
    "jsdom": "30.1.3",
    "knip": "6.43.0",
    "pinia": "4.0.3",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "unocss": "66.10.5",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "jsonc-parser": "3.3.1",
    "katex": "0.19.0",
    "lowlight": "3.3.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "12.2.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "smol-toml": "1.9.0",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0",
    "yaml": "2.9.1"
  }
}
