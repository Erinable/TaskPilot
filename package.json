    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "unocss": "66.10.5",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "dependencies": {
    "element-plus": "2.14.7",
    "pinia": "4.0.3",
    "vue": "3.5.43"
