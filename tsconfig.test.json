{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.test.tsbuildinfo",
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noImplicitAny": false,
    "paths": { "@/*": ["./src/renderer/src/*"], "@shared/*": ["./src/shared/*"] }
  },
  "include": ["tests/**/*", "src/**/*.d.ts", "src/renderer/src/env.d.ts"]
}
