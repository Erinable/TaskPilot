{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "install",
    "scripts",
    "issues"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reason"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "ci",
            "install",
            "skip"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "lint",
        "build"
      ],
      "properties": {
        "test": {
          "type": "string",
          "maxLength": 64
        },
        "lint": {
          "type": "string",
          "maxLength": 64
        },
        "build": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "fix"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "fix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}